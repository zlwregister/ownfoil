# Numeric IDs from `id ownfoil-svc` on the NAS. Do not use an admin account.
OWNFOIL_UID=CHANGE_ME
OWNFOIL_GID=CHANGE_ME
NAS_LAN_IP=192.168.1.100
GAMES_DIR=/volume1/games/switch
USER_ADMIN_NAME=library-admin
USER_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_LONG_PASSWORD
USER_GUEST_NAME=switch
USER_GUEST_PASSWORD=REPLACE_WITH_DIFFERENT_LONG_PASSWORD
